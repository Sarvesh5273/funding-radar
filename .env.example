TINYFISH_API_KEY=your_personal_tinyfish_api_key
PORT=3000
# Required for a publicly hosted deployment. Do not put this in VITE_* variables.
RADAR_ACCESS_TOKEN=
# Disable new paid jobs on a public reviewer demo; saved real runs remain readable.
RADAR_ALLOW_LIVE=true
RADAR_MAX_ACTIVE_RUNS=3
RADAR_MAX_AGENT_CALLS=3
RADAR_BROWSER_CONTACTS=2
RADAR_DATA_DIR=data/private
# Quantized sentence embeddings download once, then stay cached locally.
RADAR_EMBEDDINGS=true
